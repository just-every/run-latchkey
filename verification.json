{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "node --test --test-concurrency=1 tests/demo-owner-claim.test.mjs",
        "pnpm run test:runtime",
        "node --test tests/site/site.test.mjs"
      ]
    },
    {
      "name": "vault-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/vault.mjs",
        "node tests/browser/reviews.mjs",
        "node --test tests/latchkey-records.test.mjs tests/latchkey-local-records.test.mjs"
      ]
    },
    {
      "name": "organization-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/organization.mjs"
      ]
    },
    {
      "name": "machines-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/projects.mjs"
      ]
    },
    {
      "name": "administration-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "perl -e 'setpgrp(0,0); exec @ARGV' -- node tests/browser/automation.mjs"
      ]
    },
    {
      "name": "msp-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/msp.mjs",
        "node tests/browser/msp-lifecycle.mjs"
      ]
    }
  ],
  "nightly": []
}
