{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime",
        "pnpm exec rer build --site --no-queue"
      ]
    },
    {
      "name": "vault-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/vault.mjs",
        "node tests/browser/reviews.mjs",
        "node --test tests/latchkey-records.test.mjs tests/latchkey-local-records.test.mjs"
      ]
    },
    {
      "name": "organization-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "node tests/browser/organization.mjs"
      ]
    }
  ],
  "nightly": []
}
